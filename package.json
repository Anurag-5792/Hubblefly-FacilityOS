{
  "name": "hubblefly-facilityos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "prebuild": "node tools/hft_neon_staging_discovery.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:migrations:contract": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify": "node tools/hft_check_lockfile.mjs && npm run verify:hygiene && npm run lint && npm run typecheck && npm run test:unit && npm run test:migrations:contract && npm run verify:handover && npm run build",
    "verify:lock": "node tools/hft_check_lockfile.mjs",
    "verify:handover": "python3 tools/hft_check_handover_docs.py",
    "verify:online-db": "node --experimental-strip-types tools/hft_online_db_preflight.mjs --stores",
    "verify:online-db:masters": "node --experimental-strip-types tools/hft_online_db_preflight.mjs --masters",
    "verify:neon:staging": "node tools/hft_neon_staging_discovery.mjs",
    "verify:hygiene": "node tools/hft_verify_repository_hygiene.mjs && tsc --noEmit --incremental false --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "5.8.3",
    "@types/pg": "8.23.1"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
