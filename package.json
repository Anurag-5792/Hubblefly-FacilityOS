{
  "name": "hubblefly-facilityos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "tsc --noEmit && eslint .",
    "build": "next build",
    "start": "next start",
    "supabase:version": "node scripts/db/local-db.mjs version",
    "supabase:start": "node scripts/db/local-db.mjs start",
    "supabase:stop": "node scripts/db/local-db.mjs stop",
    "db:migration:new": "node scripts/db/local-db.mjs migration-new",
    "db:migrate": "node scripts/db/local-db.mjs migrate",
    "db:reset": "node scripts/db/local-db.mjs reset",
    "db:types:supabase": "node scripts/db/local-db.mjs types-supabase",
    "db:types:kysely": "node scripts/db/local-db.mjs types-kysely",
    "db:types": "node scripts/db/local-db.mjs types",
    "db:verify:runtime": "node scripts/db/local-db.mjs verify-runtime",
    "db:verify": "node scripts/db/local-db.mjs verify"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "next": "16.3.5",
    "pg": "8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "kysely-codegen": "0.20.0",
    "prettier": "^3.0.0",
    "supabase": "2.117.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
