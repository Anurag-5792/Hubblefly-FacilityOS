{
  "name": "hubblefly-facilityos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:migrations:contract": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify": "node tools/hft_check_lockfile.mjs && npm run lint && npm run typecheck && npm run test:unit && npm run test:migrations:contract && npm run build",
    "verify:lock": "node tools/hft_check_lockfile.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "5.8.3"
  }
}
