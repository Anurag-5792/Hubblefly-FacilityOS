{
  "name": "hubblefly-facilityos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "tsc --noEmit && eslint .",
    "build": "next build",
    "start": "next start",
    "test:db:unit": "vitest run tests/unit/platform/db",
    "test:db:integration": "node scripts/db/local-db.mjs test-access",
    "test:platform:unit": "vitest run tests/unit/platform/primitives",
    "supabase:version": "node scripts/db/local-db.mjs version",
    "supabase:start": "node scripts/db/local-db.mjs start",
    "supabase:stop": "node scripts/db/local-db.mjs stop",
    "db:migration:new": "node scripts/db/local-db.mjs migration-new",
    "db:migrate": "node scripts/db/local-db.mjs migrate",
    "db:reset": "node scripts/db/local-db.mjs reset",
    "db:types:supabase": "node scripts/db/local-db.mjs types-supabase",
    "db:types:kysely": "node scripts/db/local-db.mjs types-kysely",
    "db:types": "node scripts/db/local-db.mjs types",
    "db:verify:runtime": "node scripts/db/local-db.mjs verify-runtime",
    "db:verify": "node scripts/db/local-db.mjs verify",
    "test:core:unit": "vitest run tests/unit/core",
    "test:core:integration": "node scripts/db/local-db.mjs test-core",
    "test:auth:unit": "vitest run tests/unit/auth/",
    "test:auth:integration": "node scripts/db/local-db.mjs test-auth",
    "auth:bootstrap:local": "node scripts/auth/bootstrap-local-user.mjs",
    "test:authorization:unit": "vitest run tests/unit/authorization",
    "test:authorization:integration": "node scripts/db/local-db.mjs test-authorization",
    "test:rls:unit": "vitest run tests/unit/platform/db/rls-context.test.ts",
    "test:rls:integration": "node scripts/db/local-db.mjs test-rls",
    "test:governance:unit": "vitest run tests/unit/governance",
    "test:governance:integration": "node scripts/db/local-db.mjs test-governance"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "kysely": "0.29.6",
    "next": "16.3.5",
    "pg": "8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "kysely-codegen": "0.20.0",
    "prettier": "^3.0.0",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
