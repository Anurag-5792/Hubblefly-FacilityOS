# =============================================================================
# TARGET FACILITYOS FOUNDATION — WAVE 0 PLACEHOLDERS ONLY
# =============================================================================
# Hosted values are NOT configured by W0-02. They document the future target runtime
# contract only. Never commit real secrets.

# =============================================================================
# W0-02 LOCAL DATABASE NOTE
# =============================================================================
# Local Supabase/PostgreSQL credentials are created by the Supabase CLI at runtime.
# They are intentionally NOT committed here. Local database scripts discover the
# local connection internally and never require hosted Supabase credentials.
#
# The placeholders below remain future hosted-environment configuration only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_me
DATABASE_URL=postgresql://replace_me

# =============================================================================
# LEGACY / CURRENT PROTOTYPE CONFIGURATION
# =============================================================================
# Retained unchanged in purpose so existing Inventory / Frappe prototype flows
# are not broken during W0-01. These settings are NOT the target architecture.
#
# ERPNext Audit Block 02 remains deferred. Do not infer production Company or
# Warehouse truth from the defaults below.

# FacilityOS server-side Frappe/ERPNext connection
ERPNEXT_BASE_URL=https://your-site.frappe.cloud
ERPNEXT_API_KEY=replace_me
ERPNEXT_API_SECRET=replace_me

# MIS source for the legacy Next.js prototype:
# sample = synthetic local read model
# frappe = call the legacy FacilityOS read-model method installed on Frappe
FACILITYOS_MIS_SOURCE=sample

# Legacy FacilityOS-native operational data source:
# sample = synthetic position/container data
# frappe = call legacy FacilityOS operational methods on the Frappe site
# When omitted, this follows FACILITYOS_MIS_SOURCE.
FACILITYOS_OPERATIONS_SOURCE=sample

# Legacy user authentication:
# preview = local development identity
# frappe = login through legacy FacilityOS/Frappe authentication
FACILITYOS_AUTH_SOURCE=preview
FACILITYOS_PREVIEW_USER=preview@facilityos.local
FACILITYOS_PREVIEW_NAME=Preview User
FACILITYOS_PREVIEW_ROLE=inventory

# Historical prototype defaults — REQUIRES VALIDATION before any target binding.
FACILITYOS_DEFAULT_COMPANY=Hubblefly Technologies Limited
FACILITYOS_DEFAULT_WAREHOUSE=HFT Store
